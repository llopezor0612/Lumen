# Copia este archivo como .env y configura ambos valores en el servidor.
APP_NAME=Lumen
PORT=8765
# Modo local (recomendado): no requiere clave ni envía el chat fuera del equipo.
PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
SEARCH_ENABLED=false
SEARCH_PROVIDER=bing
SEARCH_MAX_RESULTS=5
LUMEN_UPDATE_URL=

# Alternativa en la nube (usa solo si cambias PROVIDER=openai):
# OPENAI_API_KEY=
# OPENAI_MODEL=
